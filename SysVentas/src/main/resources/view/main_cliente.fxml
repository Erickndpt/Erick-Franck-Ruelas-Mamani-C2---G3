<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.sysventas.controller.ClienteController"
            prefHeight="600.0" prefWidth="800.0">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

            <!-- 🔹 Título -->
            <Label text="Gestión de Clientes"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E90FF;"
                   alignment="CENTER" maxWidth="Infinity"/>

            <!-- 🔹 Formulario -->
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="75"/>
                </columnConstraints>

                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <Label text="DNI/RUC:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDniruc" promptText="Ingrese DNI o RUC"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombres:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombres" promptText="Ingrese nombres"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Apellidos:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtApellidos" promptText="Ingrese apellidos"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Teléfono:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTelefono" promptText="Ingrese teléfono"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Dirección:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDireccion" promptText="Ingrese dirección"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Botones de acción -->
                <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.rowIndex="5" GridPane.columnIndex="1">
                    <Button text="Guardar" onAction="#validarFormulario"
                            style="-fx-background-color: #1E90FF; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Limpiar" onAction="#clearForm"
                            style="-fx-background-color: #FF6347; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

            </GridPane>

            <!-- 🔹 Campo de búsqueda -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtFiltroDato" promptText="Ingrese nombre, apellido o DNI" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- 🔹 Tabla -->
            <TableView fx:id="tableView" prefHeight="300" VBox.vgrow="ALWAYS"/>

            <!-- 🔹 Mensaje inferior -->
            <Label fx:id="lbnMsg" text="" alignment="CENTER"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;" maxWidth="Infinity"/>

        </VBox>
    </children>
</AnchorPane>
